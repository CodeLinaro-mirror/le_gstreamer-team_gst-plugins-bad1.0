#!/usr/bin/env python3
# Load every typelib in gir1.2-gst-plugins-extra-1.0 with the -bad one
# absent, so a namespace left in, or needing, -bad fails here.

import importlib
import subprocess
import sys

import gi

# Namespace and an object it must contain, one per typelib shipped.
CASES = {
    'GstCodecParsers': 'H264NalParser',
    'GstCodecs': 'H264Decoder',
    'GstPlay': 'Play',
    'GstVa': 'VaDisplay',
}


def installed(package):
    status = subprocess.run(
        ['dpkg-query', '-W', '-f=${db:Status-Status}', package],
        capture_output=True, text=True).stdout
    return status == 'installed'


def shipped_namespaces():
    files = subprocess.run(
        ['dpkg', '-L', 'gir1.2-gst-plugins-extra-1.0'],
        capture_output=True, text=True, check=True).stdout.split()
    return {f.rsplit('/', 1)[1].rsplit('-', 1)[0]
            for f in files if f.endswith('.typelib')}


if installed('gir1.2-gst-plugins-bad-1.0'):
    sys.exit('gir1.2-gst-plugins-bad-1.0 is installed, the test proves nothing')

shipped = shipped_namespaces()
if shipped != set(CASES):
    sys.exit(f'typelibs shipped {sorted(shipped)} != tested {sorted(CASES)}')

failed = False
for namespace, name in CASES.items():
    try:
        gi.require_version(namespace, '1.0')
        module = importlib.import_module(f'gi.repository.{namespace}')
        getattr(module, name)
        print(f'OK: {namespace}.{name}')
    except Exception as e:
        print(f'FAIL: {namespace}.{name}: {e}', file=sys.stderr)
        failed = True

sys.exit(1 if failed else 0)
